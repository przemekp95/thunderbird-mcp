{
  "manifest_version": 2,
  "name": "Thunderbird MCP Safe",
  "version": "0.4.4",
  "description": "Hardened local MCP access to selected Thunderbird mail accounts, address books, and safe persistent filters",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-mcp-safe@local.invalid",
      "strict_min_version": "102.0",
      "strict_max_version": "200.*"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "mcpServer": {
      "schema": "mcp_server/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "mcpServer"
          ]
        ],
        "script": "mcp_server/api.js"
      }
    }
  },
  "options_ui": {
    "page": "options-safe.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "accountsFolders",
    "messagesMove",
    "addressBooks",
    "compose"
  ],
  "web_accessible_resources": []
}
