#!/bin/sh
set -eu

npm test
npm run lint

package_version="$(node -p "require('./package.json').version")"
manifest_version="$(node -p "require('./extension/manifest.json').version")"

if [ "$package_version" != "$manifest_version" ]; then
  echo "package.json version ($package_version) does not match extension/manifest.json version ($manifest_version)" >&2
  exit 1
fi

echo "Versions in sync: $package_version"
